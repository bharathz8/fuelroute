DEBUG=1
SECRET_KEY=django-insecure-fuelroute-dev-key-change-in-production
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ANON_RATE_LIMIT=20/minute
USER_RATE_LIMIT=100/minute
GUNICORN_WORKERS=3

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# External Providers
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_TIMEOUT_SECONDS=10

# Vehicle & Route Optimization Configuration
ROUTE_CORRIDOR_MILES=25
MAX_RANGE_MILES=500
MPG=10
STARTING_TANK=full

# Map Display (OpenFreeMap Liberty vector style, no API key required)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

